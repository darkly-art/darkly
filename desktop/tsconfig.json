{
    "compilerOptions": {
        "target": "ES2022",
        "module": "node16",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "dist",
        "rootDir": "src",
        "sourceMap": true,
        "declaration": false,
        "lib": ["ES2022"],
        "types": ["node"]
    },
    "include": ["src/**/*.ts"],
    "exclude": ["src/**/__tests__/**", "node_modules", "dist"]
}
