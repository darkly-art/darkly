---
/*
 * Every page of the docs.
 *
 * The whole section is one route because the whole section is one shape: a
 * title, a body, and a place in the sidebar. What varies (a prose page from
 * Darkly's manual, a generated reference table, the one Svelte island) varies
 * inside the body, and none of it needs a route of its own.
 */
import { getCollection, render } from 'astro:content';
import DocsLayout from '../layouts/DocsLayout.astro';
import { buildNav, neighbours } from '../lib/docs-nav';

export async function getStaticPaths() {
    const entries = await getCollection('docs');
    const nav = buildNav(entries);

    return entries.map((entry) => ({
        // `index` is the section root at /docs/, not /docs/index/.
        params: { slug: entry.id === 'index' ? undefined : entry.id },
        props: { entry, nav },
    }));
}

const { entry, nav } = Astro.props;
const { Content, headings } = await render(entry);
const { prev, next } = neighbours(nav, entry.id);
---

<DocsLayout
    title={entry.data.title}
    description={entry.data.description}
    nav={nav}
    current={entry.id}
    headings={headings}
    prev={prev}
    next={next}
>
    <Content />
</DocsLayout>
