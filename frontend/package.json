{
    "name": "darkly-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "wasm:build-dev": "cd wasm && wasm-pack build --dev --target web --out-dir pkg",
        "wasm:build-dev-profile": "cd wasm && wasm-pack build --dev --target web --out-dir pkg -- --features profile",
        "wasm:build": "cd wasm && wasm-pack build --release --target web --out-dir pkg",
        "gen:icons": "node scripts/gen-icon-bundle.mjs",
        "dev": "vite",
        "start": "npm run wasm:build-dev && vite",
        "start:app": "npm run wasm:build-dev && vite --mode app",
        "start:profile": "npm run wasm:build-dev-profile && vite",
        "build": "npm run wasm:build && vite build --mode app",
        "build:demo": "npm run wasm:build && vite build --mode demo",
        "check": "npm run gen:icons && svelte-check --tsconfig ./tsconfig.json",
        "preview": "vite preview",
        "pretest": "npm run gen:icons",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@iconify/json": "^2.2.504",
        "@iconify/svelte": "^5.2.2",
        "@iconify/utils": "^3.1.4",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@vitejs/plugin-basic-ssl": "^2.1.4",
        "@webgpu/types": "^0.1.71",
        "fake-indexeddb": "^6.2.5",
        "jpeg-js": "^0.4.4",
        "jsdom": "^29.1.1",
        "svelte": "^5.56.7",
        "svelte-check": "^4.7.3",
        "typescript": "^6.0.3",
        "vite": "^8.1.5",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^4.1.10"
    },
    "dependencies": {
        "defu": "^6.1.4",
        "fflate": "^0.8.3",
        "gifenc": "^1.0.3",
        "mediabunny": "^1.50.9",
        "tinykeys": "^4.0.0",
        "woff2-encoder": "^2.0.0"
    }
}
