{
    "name": "darkly-frontend",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "gen:icons": "node scripts/gen-icon-bundle.mjs",
        "dev": "vite",
        "start": "make -C .. wasm PROFILE=dev && vite",
        "start:app": "make -C .. wasm PROFILE=dev && vite --mode app",
        "start:profile": "make -C .. wasm PROFILE=dev FEATURES=profile && vite",
        "build": "vite build --mode app",
        "build:demo": "vite build --mode demo",
        "check": "npm run gen:icons && svelte-check --tsconfig ./tsconfig.json",
        "preview": "vite preview",
        "pretest": "npm run gen:icons",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@iconify/json": "^2.2.531",
        "@iconify/svelte": "^5.2.2",
        "@iconify/utils": "^3.1.7",
        "@resvg/resvg-js": "^2.6.2",
        "@sveltejs/vite-plugin-svelte": "^7.3.0",
        "@vitejs/plugin-basic-ssl": "^2.1.4",
        "@webgpu/types": "^0.1.74",
        "fake-indexeddb": "^6.2.5",
        "jpeg-js": "^0.4.4",
        "jsdom": "^30.1.0",
        "svelte": "^5.57.1",
        "svelte-check": "^4.7.6",
        "typescript": "^6.0.3",
        "vite": "^8.3.0",
        "vite-plugin-pwa": "^1.3.0",
        "vitest": "^5.0.1"
    },
    "dependencies": {
        "defu": "^6.1.4",
        "fflate": "^0.8.3",
        "gifenc": "^1.0.3",
        "mediabunny": "^1.58.1",
        "tinykeys": "^4.0.0",
        "woff2-encoder": "^2.0.0"
    }
}
